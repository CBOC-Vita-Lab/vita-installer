{
  "name": "cboc-vita-installer",
  "productName": "CBOC Vita Installer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prepare and install reviewed Vita releases without replacing existing data.",
  "author": "CBOC-Vita",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "test": "vitest run",
    "test:ui": "vitest run tests/ui",
    "test:worker": "npm run build && node scripts/verify-worker.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/stage-package.mjs && electron-forge package",
    "make": "npm run build && node scripts/stage-package.mjs && electron-forge make"
  },
  "dependencies": {
    "basic-ftp": "6.2.3",
    "fast-xml-parser": "5.11.2",
    "jsonc-parser": "3.3.1",
    "luaparse": "0.3.1",
    "lucide-react": "1.59.0",
    "plist": "5.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/luaparse": "0.2.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "node": "24.22.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
